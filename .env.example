# Copy this file to .env and fill in your values

# ── LiveKit Cloud ─────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# ── Speech / AI providers (cloud — used as fallbacks when self-hosted) ─────────
DEEPGRAM_API_KEY=your_deepgram_key
OPENAI_API_KEY=your_openai_key
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=6wMF5aBsi9xsISTPVsWw

# ── Self-hosted model stack (Vast.ai GPU box) ─────────────────────────────────
# USE_SELF_HOSTED=1 → local Qwen/Whisper/Orpheus as PRIMARY, cloud as fallback.
# USE_SELF_HOSTED=0 → cloud-only (original behavior).
USE_SELF_HOSTED=0
LOCAL_LLM_URL=http://localhost:8001/v1
LOCAL_LLM_MODEL=sara-llm
LOCAL_STT_URL=http://localhost:8002/v1
LOCAL_TTS_URL=http://localhost:8003/v1
LOCAL_TTS_MODEL=orpheus
LOCAL_TTS_VOICE=

# ── Dashboard (Next.js) ───────────────────────────────────────────────────────
# LOCAL:      http://localhost:3000
# PRODUCTION: https://your-dashboard.vercel.app
DASHBOARD_URL=http://localhost:3000

# ── CRM webhook (optional) ────────────────────────────────────────────────────
# POST full call payload here at call end. Leave blank to disable.
CRM_WEBHOOK_URL=
